{
  "name": "dth/account-management",
  "description": "DTH Account & Access Management module: users, roles, permissions, groups, invitations, sessions, audit logs and access settings.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Dth\\AccountManagement\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dth\\AccountManagement\\AccountManagementServiceProvider"
      ]
    },
    "dth-module": {
      "id": "account-management",
      "name": "Tài khoản & Phân quyền",
      "order": 60,
      "enabled_config": "dth-account-management.enabled",
      "filament": {
        "plugin": "Dth\\AccountManagement\\Filament\\AccountManagementPlugin",
        "auth_middleware": [
          "Dth\\AccountManagement\\Http\\Middleware\\EnsureAccountIsActive"
        ]
      },
      "dependencies": {
        "required": [],
        "optional": [
          "dth/human-resource"
        ],
        "integrations": [
          "dth/human-resource"
        ]
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "filament/filament": "Host application should use Filament 4.x for the administration UI.",
    "dth/human-resource": "Optional employee-account linking and employee lifecycle synchronization."
  }
}
