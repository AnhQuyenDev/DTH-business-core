{
  "name": "dth/crm",
  "description": "DTH CRM module: contacts, companies, leads, qualification, distribution and customer lifecycle.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "dth/human-resource": "@dev",
    "laravel/framework": "^12.0",
    "php": "^8.2",
    "openspout/openspout": "^4.23"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Dth\\Crm\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dth\\Crm\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dth\\Crm\\CrmServiceProvider"
      ]
    },
    "dth-module": {
      "id": "crm",
      "name": "CRM",
      "order": 40,
      "enabled_config": "dth-crm.enabled",
      "filament": {
        "plugin": "Dth\\Crm\\Filament\\CrmPlugin"
      },
      "dependencies": {
        "required": [
          "dth/human-resource"
        ],
        "optional": [
          "dth/marketing",
          "dth/commercial"
        ],
        "integrations": [
          "dth/marketing",
          "dth/commercial"
        ]
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "filament/filament": "Host application should use Filament 4.13.x for the CRM admin UI.",
    "dth/marketing": "Enables Marketing AudienceProvider and LeadProvider integration.",
    "dth/commercial": "Enables qualified-lead handoff into Commercial opportunities."
  }
}
