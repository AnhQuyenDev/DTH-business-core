{
  "name": "dth/email",
  "description": "Reusable email delivery, campaign, template, tracking and suppression module for DTH business applications.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "dompdf/dompdf": "^3.1.6",
    "openspout/openspout": "^4.23"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Dth\\Email\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dth\\Email\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dth\\Email\\EmailServiceProvider"
      ]
    },
    "dth-module": {
      "id": "email",
      "name": "Email",
      "order": 10,
      "filament": {
        "plugin": "Dth\\Email\\Filament\\EmailPlugin"
      },
      "dependencies": {
        "required": [],
        "optional": [
          "dth/marketing"
        ],
        "integrations": [
          "dth/marketing"
        ]
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "filament/filament": "Provides the optional DTH Email administration UI.",
    "dth/marketing": "Provides Marketing Campaign context for linked Email Campaigns."
  }
}
