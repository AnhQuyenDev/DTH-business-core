APP_NAME="DTH Business Core"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Safe baseline without additional infrastructure.
# If Redis is available, use redis for CACHE_STORE and SESSION_DRIVER.
CACHE_STORE=database
DASHBOARD_CACHE_SECONDS=45
PERFORMANCE_TRACE_ENABLED=false
PERFORMANCE_SLOW_REQUEST_MS=750
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Do not use sync for production email/import workloads.
# Start a queue worker when using the database connection.
QUEUE_CONNECTION=database
QUOTATION_EMAIL_QUEUE_ENABLED=true
QUOTATION_EMAIL_QUEUE=quotations

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BUSINESS_FLOW_V2_ENABLED=true
COMPANY_RESOLUTION_ENABLED=true
OPPORTUNITY_QUOTATION_ENABLED=true
CUSTOMER_ON_PAID_ONLY=true

V1_QUOTATION_APPROVAL_MODE=amount_or_discount
V1_QUOTATION_APPROVAL_AMOUNT=20000000
V1_QUOTATION_APPROVAL_DISCOUNT_PERCENT=10
V1_QUOTATION_CONFIRMATION_MODE=click
V1_PAYMENT_EVIDENCE_REQUIRED=false
V1_SUPPORT_DEFAULT_PRIORITY=normal
V1_SUPPORT_SENDING_ACCOUNT_ID=
V1_SUPPORT_INBOUND_WEBHOOK_SECRET=

PAYMENT_EVIDENCE_DISK=local
PAYMENT_EVIDENCE_MAX_FILES=3
PAYMENT_EVIDENCE_MAX_KB=10240
PAYMENT_RECEIPT_DISK=local

EINVOICE_PROVIDER=none
EINVOICE_AUTO_ISSUE_ON_PAID=false

VITE_APP_NAME="${APP_NAME}"
