digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=0.6, fontname="DejaVu Sans", label="Cơ cấu tổ chức không đồng nghĩa với quyền hệ thống", labelloc=t, fontsize=22, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12", color="#cbd5e1", fillcolor="#ffffff", fontcolor="#111827"];
  edge [color="#64748b", penwidth=1.4, arrowsize=0.75];
  person [label="Nguyễn A\nNhân viên thực tế", fillcolor="#fff7ed", color="#fb923c", penwidth=2];
  dept [label="Phòng Điều hành\n(Cơ cấu)", fillcolor="#eff6ff", color="#60a5fa"];
  title [label="Trưởng phòng\n(Chức danh dùng chung)", fillcolor="#f5f3ff", color="#8b5cf6"];
  funcs [label="Marketing + Sales + CSKH\n(Chức năng nghiệp vụ)", fillcolor="#ecfdf5", color="#34d399"];
  account [label="nguyena@company.vn\n(Tài khoản)", fillcolor="#f0fdfa", color="#2dd4bf"];
  perms [label="Permission phù hợp\n(Quyền phần mềm)", fillcolor="#fef2f2", color="#f87171"];
  person -> dept; person -> title; person -> funcs; person -> account -> perms;
}
