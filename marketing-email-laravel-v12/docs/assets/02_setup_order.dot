digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.35, ranksep=0.45, fontname="DejaVu Sans", label="Thứ tự cấu hình khuyến nghị", labelloc=t, fontsize=24, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.20,0.12", color="#d1d5db", fillcolor="#ffffff", fontcolor="#111827"];
  edge [color="#94a3b8", penwidth=1.5, arrowsize=0.75];
  company [label="0. CÀI ĐẶT CÔNG TY\nThông tin doanh nghiệp, chính sách chung", fillcolor="#f8fafc"];
  dept [label="1A. PHÒNG BAN\nTạo đơn vị tổ chức + màu nhận diện", fillcolor="#eff6ff", color="#60a5fa"];
  title [label="1B. CHỨC DANH\nTạo catalog dùng chung toàn công ty", fillcolor="#f5f3ff", color="#8b5cf6"];
  staff [label="2. NHÂN VIÊN\nChọn Phòng ban + Chức danh", fillcolor="#fff7ed", color="#fb923c"];
  func [label="3. CHỨC NĂNG NGHIỆP VỤ\nKhai báo nghiệp vụ chính/kiêm nhiệm + thẩm quyền", fillcolor="#ecfdf5", color="#34d399"];
  acct [label="4. TÀI KHOẢN TRUY CẬP\nCấp email đăng nhập khi cần", fillcolor="#f0fdfa", color="#2dd4bf"];
  role [label="5. VAI TRÒ & QUYỀN\nBổ sung role/permission chi tiết nếu cần", fillcolor="#fef2f2", color="#f87171"];
  appearance [label="6. GIAO DIỆN & MÀU SẮC\nTinh chỉnh màu Business Function / Role / Audience", fillcolor="#fffbeb", color="#fbbf24"];
  company -> dept; company -> title; dept -> staff; title -> staff; staff -> func -> acct -> role -> appearance;
  {rank=same; dept; title}
}
