digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.55, fontname="DejaVu Sans", label="Quản trị màu thống nhất", labelloc=t, fontsize=24, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12", color="#d1d5db", fillcolor="#ffffff", fontcolor="#111827"];
  edge [color="#64748b", penwidth=1.4, arrowsize=0.75];
  palette [label="SYSTEM COLOR PALETTE\n22 màu dùng chung", fillcolor="#f8fafc", penwidth=2];
  dept [label="Department.color\nNgười quản trị được chọn", fillcolor="#eff6ff", color="#60a5fa"];
  func [label="Business Function color\nQuản lý tập trung", fillcolor="#ecfdf5", color="#34d399"];
  role [label="Role / Audience color\nCó thể tùy chỉnh", fillcolor="#f5f3ff", color="#8b5cf6"];
  status [label="Business Status\nKHÓA theo semantic\nSuccess / Warning / Danger / Info / Gray", fillcolor="#fef2f2", color="#f87171"];
  deptui [label="Badge Phòng ban\nở mọi màn hình đã kết nối", fillcolor="#ffffff"];
  funcui [label="Badge Marketing / Sales / Finance / CSKH", fillcolor="#ffffff"];
  roleui [label="Badge vai trò / đối tượng", fillcolor="#ffffff"];
  statusui [label="Paid / Pending / Rejected / Active...", fillcolor="#ffffff"];
  palette -> dept; palette -> func; palette -> role; palette -> status;
  dept -> deptui; func -> funcui; role -> roleui; status -> statusui;
}
