digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.55, ranksep=0.8, fontname="DejaVu Sans", label="Mô hình nghiệp vụ Module Cấu hình V2", labelloc=t, fontsize=24, fontcolor="#0f172a"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.18,0.12", color="#cbd5e1", penwidth=1.2, fillcolor="#f8fafc", fontcolor="#0f172a"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.8];
  dept [label="PHÒNG BAN\nĐơn vị tổ chức\nMàu nhận diện riêng", fillcolor="#eff6ff", color="#60a5fa"];
  title [label="CHỨC DANH\nDanh mục dùng chung\nKhông thuộc riêng phòng ban", fillcolor="#f5f3ff", color="#8b5cf6"];
  staff [label="NHÂN VIÊN\nHồ sơ con người\nNối Phòng ban + Chức danh", fillcolor="#fff7ed", color="#fb923c", penwidth=2];
  func [label="CHỨC NĂNG NGHIỆP VỤ\nMarketing / Kinh doanh /\nTài chính / CSKH...\nCó thể kiêm nhiệm", fillcolor="#ecfdf5", color="#34d399"];
  account [label="TÀI KHOẢN TRUY CẬP\nDanh tính đăng nhập\nCó thể cấp sau", fillcolor="#f0fdfa", color="#2dd4bf"];
  role [label="VAI TRÒ & QUYỀN\nPermission phần mềm\nĐộc lập cơ cấu tổ chức", fillcolor="#fef2f2", color="#f87171"];
  dept -> staff [label=" trực thuộc "];
  title -> staff [label=" sử dụng "];
  staff -> func [label=" 1..n "];
  staff -> account [label=" 0..1 "];
  account -> role [label=" gán quyền "];
}
